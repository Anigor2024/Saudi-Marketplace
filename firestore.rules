rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isNonNegativeNumber(val) {
      return val is number && val >= 0;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isValidString(request.resource.data.titleAr, 2, 300)
        && isValidString(request.resource.data.titleEn, 2, 300)
        && isNonNegativeNumber(request.resource.data.price)
        && isNonNegativeNumber(request.resource.data.stock);
      allow delete: if true;
    }

    match /sellers/{sellerId} {
      allow read: if true;
      allow create, update: if isValidString(request.resource.data.nameAr, 2, 200)
        && isValidString(request.resource.data.nameEn, 2, 200);
      allow delete: if true;
    }

    match /orders/{orderId} {
      allow read: if true;
      allow create, update: if isValidString(request.resource.data.orderNumber, 3, 60)
        && isNonNegativeNumber(request.resource.data.total);
      allow delete: if true;
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow create, update: if isValidString(request.resource.data.code, 2, 40)
        && isNonNegativeNumber(request.resource.data.value);
      allow delete: if true;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if isValidString(request.resource.data.productId, 1, 100)
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow delete: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidString(request.resource.data.email, 3, 200)
        && request.resource.data.role in ['customer', 'seller', 'admin'];
      allow delete: if true;
    }

    match /auditLogs/{logId} {
      allow read: if true;
      allow create, update: if isValidString(request.resource.data.actionAr, 2, 500);
      allow delete: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /questions/{questionId} {
      allow read, write: if true;
    }

    match /tickets/{ticketId} {
      allow read, write: if true;
    }
  }
}
