rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives & Validation Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isNonNegativeNumber(val) {
      return val is number && val >= 0;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Production Admin authorization:
    // Recognizes a verified Firebase Auth Custom Claim (`admin == true` or `role == 'admin'`)
    // provisioned from a trusted server/Firebase Admin SDK environment, or an Admin-provisioned
    // user profile (`role == 'admin'`, which clients can never self-assign due to strict `/users` rules).
    // No personal email addresses are hard-coded in rules.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'admin' ||
        (userDocExists() && currentUserData().role == 'admin')
      );
    }

    function isSeller() {
      return isSignedIn()
        && userDocExists()
        && currentUserData().role == 'seller'
        && currentUserData().get('sellerId', '') is string
        && currentUserData().get('sellerId', '').size() > 0
        && exists(/databases/$(database)/documents/sellers/$(currentUserData().sellerId))
        && get(/databases/$(database)/documents/sellers/$(currentUserData().sellerId)).data.status == 'approved';
    }

    function ownsSellerAccount(sellerId) {
      return isSeller() && sellerId is string && currentUserData().sellerId == sellerId;
    }

    // Helper: Verifies that the authenticated user is the linked seller for `sellerId`
    // regardless of whether the seller account is currently approved or suspended (used for private read access only).
    function isLinkedSellerOwner(sellerId) {
      return isSignedIn()
        && sellerId is string
        && userDocExists()
        && currentUserData().role == 'seller'
        && currentUserData().get('sellerId', '') == sellerId;
    }

    // Helper: Enforces strict schema and key whitelist for PublicSellerProfile documents
    // so private fields (IBAN, financials, email, phone, applicantUserId, etc.) can NEVER enter sellerPublicProfiles.
    function isValidPublicSellerProfile(data, sellerId) {
      return data.keys().hasAll([
          'id',
          'nameAr',
          'nameEn',
          'descriptionAr',
          'descriptionEn',
          'cityAr',
          'cityEn',
          'status',
          'verifiedBadge',
          'rating',
          'reviewCount',
          'categories',
          'joinedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'nameAr',
          'nameEn',
          'descriptionAr',
          'descriptionEn',
          'cityAr',
          'cityEn',
          'status',
          'verifiedBadge',
          'rating',
          'reviewCount',
          'categories',
          'joinedAt'
        ])
        && data.id == sellerId
        && isValidString(data.nameAr, 2, 200)
        && isValidString(data.nameEn, 2, 200)
        && data.descriptionAr is string && data.descriptionAr.size() <= 2000
        && data.descriptionEn is string && data.descriptionEn.size() <= 2000
        && data.cityAr is string && data.cityAr.size() <= 120
        && data.cityEn is string && data.cityEn.size() <= 120
        && data.status in ['approved', 'pending', 'suspended', 'rejected']
        && data.verifiedBadge is bool
        && isNonNegativeNumber(data.rating)
        && isNonNegativeNumber(data.reviewCount)
        && data.categories is list
        && data.categories.size() <= 20
        && data.joinedAt is string && data.joinedAt.size() <= 60;
    }

    // Helper: Verifies that the authenticated Seller owns the referenced Product document
    function ownsProduct(productId) {
      return isSeller()
        && productId is string
        && isValidId(productId)
        && exists(/databases/$(database)/documents/products/$(productId))
        && get(/databases/$(database)/documents/products/$(productId)).data.sellerId == currentUserData().sellerId;
    }

    // Helper: Validates a single Frequently Bought Together bundled product ID:
    // - must be a valid string ID
    // - must not reference the product itself (no self-bundling)
    // - must exist in /products/{bundleId}
    // - must belong to the exact same sellerId
    function isValidBundleItem(bundleId, selfProductId, expectedSellerId) {
      return bundleId is string
        && isValidId(bundleId)
        && bundleId != selfProductId
        && exists(/databases/$(database)/documents/products/$(bundleId))
        && get(/databases/$(database)/documents/products/$(bundleId)).data.sellerId == expectedSellerId;
    }

    // Helper: Validates frequentlyBoughtWith list on product create/update (max 4 unique same-seller SKUs)
    function isValidFrequentlyBoughtWith(data, selfProductId, expectedSellerId) {
      return !('frequentlyBoughtWith' in data)
        || (
          data.frequentlyBoughtWith is list
          && data.frequentlyBoughtWith.size() <= 4
          && (data.frequentlyBoughtWith.size() < 1 || isValidBundleItem(data.frequentlyBoughtWith[0], selfProductId, expectedSellerId))
          && (data.frequentlyBoughtWith.size() < 2 || (
            data.frequentlyBoughtWith[1] != data.frequentlyBoughtWith[0]
            && isValidBundleItem(data.frequentlyBoughtWith[1], selfProductId, expectedSellerId)
          ))
          && (data.frequentlyBoughtWith.size() < 3 || (
            data.frequentlyBoughtWith[2] != data.frequentlyBoughtWith[0]
            && data.frequentlyBoughtWith[2] != data.frequentlyBoughtWith[1]
            && isValidBundleItem(data.frequentlyBoughtWith[2], selfProductId, expectedSellerId)
          ))
          && (data.frequentlyBoughtWith.size() < 4 || (
            data.frequentlyBoughtWith[3] != data.frequentlyBoughtWith[0]
            && data.frequentlyBoughtWith[3] != data.frequentlyBoughtWith[1]
            && data.frequentlyBoughtWith[3] != data.frequentlyBoughtWith[2]
            && isValidBundleItem(data.frequentlyBoughtWith[3], selfProductId, expectedSellerId)
          ))
        );
    }

    // Helper for Verified Purchase Review Integrity:
    // Ensures the referenced order exists, belongs to request.auth.uid, has status == 'delivered',
    // AND its immutable `productIds` list explicitly contains the reviewed `productId`.
    function isDeliveredOrderForProduct(orderId, productId) {
      return orderId is string
        && orderId.size() > 0
        && isValidId(orderId)
        && exists(/databases/$(database)/documents/orders/$(orderId))
        && get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(orderId)).data.status == 'delivered'
        && productId in get(/databases/$(database)/documents/orders/$(orderId)).data.get('productIds', []);
    }

    // 1. PRODUCTS: Public read for active/out_of_stock;
    // Seller manages own catalog fields but NEVER modifies platform-owned metrics
    // (sellerId, sellerRating, sellerVerified, rating, reviewCount, soldCount);
    // Admin retains full moderation control.
    match /products/{productId} {
      allow read: if resource.data.status == 'active'
        || resource.data.status == 'out_of_stock'
        || isAdmin()
        || (isSeller() && resource.data.sellerId == currentUserData().sellerId);

      allow create: if isValidId(productId)
        && isValidString(request.resource.data.titleAr, 2, 300)
        && isValidString(request.resource.data.titleEn, 2, 300)
        && isNonNegativeNumber(request.resource.data.price)
        && isNonNegativeNumber(request.resource.data.stock)
        && (
          isAdmin() ||
          (
            ownsSellerAccount(request.resource.data.sellerId)
            && exists(/databases/$(database)/documents/sellers/$(request.resource.data.sellerId))
            && request.resource.data.sellerRating == get(/databases/$(database)/documents/sellers/$(request.resource.data.sellerId)).data.rating
            && request.resource.data.sellerVerified == get(/databases/$(database)/documents/sellers/$(request.resource.data.sellerId)).data.verifiedBadge
            && request.resource.data.rating == 0
            && request.resource.data.reviewCount == 0
            && request.resource.data.soldCount == 0
            && request.resource.data.isFeatured == false
            && request.resource.data.isTrending == false
            && request.resource.data.isBestSeller == false
            && request.resource.data.status in ['active', 'draft', 'out_of_stock']
            && isValidFrequentlyBoughtWith(request.resource.data, productId, request.resource.data.sellerId)
          )
        );

      allow update: if isValidId(productId)
        && isValidString(request.resource.data.titleAr, 2, 300)
        && isValidString(request.resource.data.titleEn, 2, 300)
        && isNonNegativeNumber(request.resource.data.price)
        && isNonNegativeNumber(request.resource.data.stock)
        && (
          isAdmin() ||
          (
            ownsSellerAccount(resource.data.sellerId)
            && resource.data.status != 'suspended'
            && request.resource.data.sellerId == resource.data.sellerId
            && request.resource.data.sellerRating == resource.data.sellerRating
            && request.resource.data.sellerVerified == resource.data.sellerVerified
            && request.resource.data.rating == resource.data.rating
            && request.resource.data.reviewCount == resource.data.reviewCount
            && request.resource.data.soldCount == resource.data.soldCount
            && request.resource.data.status in ['active', 'draft', 'out_of_stock']
            && isValidFrequentlyBoughtWith(request.resource.data, productId, resource.data.sellerId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'sku',
              'titleAr',
              'titleEn',
              'descriptionAr',
              'descriptionEn',
              'categoryId',
              'subcategoryAr',
              'subcategoryEn',
              'brandId',
              'brandNameAr',
              'brandNameEn',
              'price',
              'originalPrice',
              'discountPercent',
              'stock',
              'lowStockThreshold',
              'status',
              'images',
              'variants',
              'specifications',
              'warrantyAr',
              'warrantyEn',
              'deliveryEstimateAr',
              'deliveryEstimateEn',
              'isFlashDeal',
              'flashDealEndsAt',
              'isSeasonal',
              'frequentlyBoughtWith'
            ])
          )
        );

      allow delete: if isValidId(productId) && (isAdmin() || ownsSellerAccount(resource.data.sellerId));
    }

    // 2. SELLERS (PRIVATE MERCHANT RECORD):
    // Public anonymous users NEVER read /sellers/{sellerId}.
    // Private read is allowed ONLY for:
    // - Admin (all seller records)
    // - Linked Seller identity for their own store (including suspended sellers viewing their account status)
    // - Applicant viewing their own pending/submitted application where resource.data.applicantUserId == request.auth.uid
    // Operational Seller writes still require an active 'approved' Seller account via ownsSellerAccount(sellerId).
    match /sellers/{sellerId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || isLinkedSellerOwner(sellerId)
        || resource.data.get('applicantUserId', '') == request.auth.uid
      );

      allow create: if isSignedIn()
        && isValidId(sellerId)
        && isValidString(request.resource.data.nameAr, 2, 200)
        && isValidString(request.resource.data.nameEn, 2, 200)
        && (
          isAdmin() ||
          (
            request.resource.data.applicantUserId == request.auth.uid
            && request.resource.data.status == 'pending'
            && request.resource.data.verifiedBadge == false
            && request.resource.data.grossSales == 0
            && request.resource.data.platformCommission == 0
            && request.resource.data.refundsTotal == 0
            && request.resource.data.netEarnings == 0
            && request.resource.data.availableBalance == 0
            && request.resource.data.payoutHistory.size() == 0
          )
        );

      allow update: if isValidId(sellerId)
        && isValidString(request.resource.data.nameAr, 2, 200)
        && isValidString(request.resource.data.nameEn, 2, 200)
        && (
          isAdmin() ||
          (
            ownsSellerAccount(sellerId)
            && request.resource.data.get('applicantUserId', null) == resource.data.get('applicantUserId', null)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'nameAr',
              'nameEn',
              'descriptionAr',
              'descriptionEn',
              'cityAr',
              'cityEn',
              'phone',
              'email',
              'iban',
              'ownerName',
              'categories',
              'crNumber',
              'vatNumber',
              'operationalSettings'
            ])
            && (
              !('operationalSettings' in request.resource.data)
              || (
                request.resource.data.operationalSettings is map
                && request.resource.data.operationalSettings.keys().hasOnly([
                  'defaultCarrier',
                  'sameDayCutoff',
                  'luxuryPackagingEnabled',
                  'coldChainEnabled',
                  'autoZatcaInvoice',
                  'whatsappOrderAlerts',
                  'lowStockEmailAlerts',
                  'updatedAt'
                ])
              )
            )
          )
        );

      allow delete: if isValidId(sellerId) && isAdmin();
    }

    // 2B. PUBLIC SELLER PROFILES (MARKETPLACE-SAFE PROJECTION):
    // Contains ONLY public presentation fields (no IBAN, no financials, no private email/phone, no applicantUserId).
    // Public may read ONLY approved public seller profiles.
    // Admin may manage all public profiles.
    // Approved Seller may update ONLY safe presentation fields belonging to their own store.
    match /sellerPublicProfiles/{sellerId} {
      allow read: if resource.data.status == 'approved'
        || isAdmin()
        || isLinkedSellerOwner(sellerId);

      allow create: if isValidId(sellerId)
        && isValidPublicSellerProfile(request.resource.data, sellerId)
        && isAdmin();

      allow update: if isValidId(sellerId)
        && isValidPublicSellerProfile(request.resource.data, sellerId)
        && (
          isAdmin()
          || (
            ownsSellerAccount(sellerId)
            && resource.data.status == 'approved'
            && request.resource.data.id == resource.data.id
            && request.resource.data.status == resource.data.status
            && request.resource.data.verifiedBadge == resource.data.verifiedBadge
            && request.resource.data.rating == resource.data.rating
            && request.resource.data.reviewCount == resource.data.reviewCount
            && request.resource.data.joinedAt == resource.data.joinedAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'nameAr',
              'nameEn',
              'descriptionAr',
              'descriptionEn',
              'cityAr',
              'cityEn',
              'categories'
            ])
          )
        );

      allow delete: if isValidId(sellerId) && isAdmin();
    }

    // 3. USERS: Customer reads/updates own profile but NEVER escalates role or sellerId; Admin manages users; No deletion
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isValidId(userId)
        && isValidString(request.resource.data.name, 2, 150)
        && isValidString(request.resource.data.email, 3, 200)
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && request.resource.data.id == request.auth.uid
            && request.resource.data.role == 'customer'
            && !('sellerId' in request.resource.data)
          )
        );

      allow update: if isValidId(userId)
        && isValidString(request.resource.data.name, 2, 150)
        && isValidString(request.resource.data.email, 3, 200)
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && request.resource.data.id == resource.data.id
            && request.resource.data.role == resource.data.role
            && request.resource.data.get('sellerId', null) == resource.data.get('sellerId', null)
          )
        );

      allow delete: if false;
    }

    // 4. ORDERS: Customer creates/reads own orders & updates ONLY cancellation/return fields;
    // Seller reads/updates ONLY fulfillment fields on orders containing their sellerId;
    // `productIds` is immutable and cannot be modified by customers or sellers; Admin accesses all.
    match /orders/{orderId} {
      allow create: if isSignedIn()
        && isValidId(orderId)
        && request.resource.data.customerId == request.auth.uid
        && isValidString(request.resource.data.orderNumber, 3, 60)
        && isNonNegativeNumber(request.resource.data.total)
        && isNonNegativeNumber(request.resource.data.vatAmount)
        && request.resource.data.productIds is list
        && request.resource.data.productIds.size() >= 1
        && request.resource.data.productIds.size() <= 50
        && request.resource.data.productIds[0] is string;

      allow read: if isSignedIn() && (
        resource.data.customerId == request.auth.uid
        || isAdmin()
        || (isSeller() && currentUserData().sellerId in resource.data.get('sellerIds', []))
      );

      allow update: if isSignedIn()
        && isValidId(orderId)
        && (
          isAdmin()
          || (
            resource.data.customerId == request.auth.uid
            && request.resource.data.get('productIds', []) == resource.data.get('productIds', [])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'cancelReason',
              'returnRequest',
              'timeline',
              'updatedAt'
            ])
            && request.resource.data.status in ['cancelled', 'return_requested']
          )
          || (
            isSeller()
            && currentUserData().sellerId in resource.data.get('sellerIds', [])
            && request.resource.data.get('productIds', []) == resource.data.get('productIds', [])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'trackingNumber',
              'carrierAr',
              'carrierEn',
              'timeline',
              'updatedAt'
            ])
            && request.resource.data.status in [
              'confirmed',
              'preparing',
              'shipped',
              'out_for_delivery',
              'delivered'
            ]
          )
        );

      allow delete: if false;
    }

    // 5. COUPONS: Public reads active coupons; Seller manages own coupon settings; Admin manages all;
    // Authoritative `usedCount` can NEVER be modified by customers or sellers (reserved for Admin / trusted backend).
    match /coupons/{couponId} {
      allow read: if resource.data.isActive == true
        || isAdmin()
        || (isSeller() && resource.data.sellerId == currentUserData().sellerId);

      allow create: if isValidId(couponId)
        && isValidString(request.resource.data.code, 2, 40)
        && isNonNegativeNumber(request.resource.data.value)
        && (
          isAdmin() ||
          (
            ownsSellerAccount(request.resource.data.sellerId)
            && request.resource.data.usedCount == 0
          )
        );

      allow update: if isValidId(couponId)
        && (
          isAdmin()
          || (
            ownsSellerAccount(resource.data.sellerId)
            && request.resource.data.sellerId == resource.data.sellerId
            && request.resource.data.usedCount == resource.data.usedCount
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'code',
              'titleAr',
              'titleEn',
              'type',
              'value',
              'minOrderAmount',
              'maxDiscount',
              'maxUses',
              'expiresAt',
              'isActive',
              'sellerNameAr'
            ])
            && isValidString(request.resource.data.code, 2, 40)
            && isNonNegativeNumber(request.resource.data.value)
          )
        );

      allow delete: if isValidId(couponId) && (isAdmin() || ownsSellerAccount(resource.data.sellerId));
    }

    // 6. REVIEWS: Public read; Authenticated user creates own review;
    // verifiedPurchase == true is strictly validated against a real DELIVERED order owned by request.auth.uid
    // whose immutable `productIds` array contains `request.resource.data.productId`.
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isSignedIn()
        && isValidId(reviewId)
        && request.resource.data.userId == request.auth.uid
        && isValidString(request.resource.data.productId, 1, 100)
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && isValidString(request.resource.data.comment, 2, 1500)
        && request.resource.data.verifiedPurchase is bool
        && (
          request.resource.data.verifiedPurchase == false
          || isAdmin()
          || isDeliveredOrderForProduct(
            request.resource.data.get('verifiedOrderId', ''),
            request.resource.data.productId
          )
        );

      allow update: if isValidId(reviewId) && (
        isAdmin()
        || (
          isSignedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.productId == resource.data.productId
          && request.resource.data.verifiedPurchase == resource.data.verifiedPurchase
          && request.resource.data.get('verifiedOrderId', null) == resource.data.get('verifiedOrderId', null)
        )
        || (
          ownsProduct(resource.data.productId)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.productId == resource.data.productId
          && request.resource.data.rating == resource.data.rating
          && request.resource.data.comment == resource.data.comment
          && request.resource.data.title == resource.data.title
          && request.resource.data.verifiedPurchase == resource.data.verifiedPurchase
          && request.resource.data.get('verifiedOrderId', null) == resource.data.get('verifiedOrderId', null)
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'sellerReplyAr',
            'sellerReplyEn',
            'sellerReplyAt'
          ])
          && isValidString(request.resource.data.sellerReplyAr, 2, 1500)
        )
      );

      allow delete: if isValidId(reviewId) && isAdmin();
    }

    // 7. PRODUCT QUESTIONS: Public read; Authenticated user asks question;
    // Seller answers ONLY questions for products owned by their sellerId and modifies ONLY answer fields; Admin manages all.
    match /questions/{questionId} {
      allow read: if true;

      allow create: if isSignedIn()
        && isValidId(questionId)
        && isValidString(request.resource.data.productId, 1, 100)
        && isValidString(request.resource.data.questionAr, 2, 800);

      allow update: if isValidId(questionId) && (
        isAdmin()
        || (
          ownsProduct(resource.data.productId)
          && request.resource.data.productId == resource.data.productId
          && request.resource.data.userName == resource.data.userName
          && request.resource.data.questionAr == resource.data.questionAr
          && request.resource.data.questionEn == resource.data.questionEn
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'answerAr',
            'answerEn',
            'answeredByAr',
            'answeredByEn',
            'answeredAt'
          ])
          && isValidString(request.resource.data.answerAr, 2, 1500)
        )
      );

      allow delete: if isValidId(questionId) && isAdmin();
    }

    // 8. SUPPORT TICKETS: Authenticated customer/seller creates & reads own tickets;
    // Admin may create tickets for another user (e.g. seller_application_info) and manages all;
    // Seller payout / return_inspection tickets require an active approved seller account via ownsSellerAccount().
    match /tickets/{ticketId} {
      allow create: if isSignedIn()
        && isValidId(ticketId)
        && isValidString(request.resource.data.subject, 2, 300)
        && isValidString(request.resource.data.message, 2, 2000)
        && (
          isAdmin()
          || (
            request.resource.data.userId == request.auth.uid
            && request.resource.data.get('workflowType', 'support') != 'seller_application_info'
            && (
              (
                !(request.resource.data.get('workflowType', 'support') in ['payout', 'return_inspection'])
                && request.resource.data.get('sellerId', '') == ''
              )
              || ownsSellerAccount(request.resource.data.get('sellerId', ''))
            )
          )
        );

      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      // Production clients (including browser Admin UI) may only transition treasuryStatus
      // among ['requested', 'under_review', 'approved_for_treasury', 'rejected'].
      // Setting 'completed' requires a trusted backend / banking integration using Admin SDK.
      allow update: if isValidId(ticketId)
        && isAdmin()
        && request.resource.data.get('treasuryStatus', 'requested') in [
          'requested',
          'under_review',
          'approved_for_treasury',
          'rejected'
        ];

      allow delete: if false;
    }

    // 9. AUDIT LOGS: Admin-only read and create; Immutable
    match /auditLogs/{logId} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && isValidId(logId)
        && isValidString(request.resource.data.actionAr, 2, 500);

      allow update, delete: if false;
    }

    // 10. SETTINGS / HOMEPAGE CONFIG: Public read; Admin-only write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId) && isAdmin();
    }
  }
}
