{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Marketplace product listing with bilingual content, variants, specs, pricing, and inventory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sku": { "type": "string" },
        "titleAr": { "type": "string" },
        "titleEn": { "type": "string" },
        "descriptionAr": { "type": "string" },
        "descriptionEn": { "type": "string" },
        "categoryId": { "type": "string" },
        "subcategoryAr": { "type": "string" },
        "subcategoryEn": { "type": "string" },
        "brandId": { "type": "string" },
        "brandNameAr": { "type": "string" },
        "brandNameEn": { "type": "string" },
        "sellerId": { "type": "string" },
        "sellerNameAr": { "type": "string" },
        "sellerNameEn": { "type": "string" },
        "sellerRating": { "type": "number" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "discountPercent": { "type": "number" },
        "stock": { "type": "number" },
        "lowStockThreshold": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "draft", "out_of_stock", "suspended"] },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "soldCount": { "type": "number" },
        "images": { "type": "array", "items": { "type": "string" } },
        "isFlashDeal": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "isTrending": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" },
        "isNewArrival": { "type": "boolean" },
        "isSeasonal": { "type": "boolean" },
        "frequentlyBoughtWith": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "sku", "titleAr", "titleEn", "categoryId", "sellerId", "price", "stock", "status"]
    },
    "Seller": {
      "title": "Seller",
      "description": "Private multi-vendor merchant profile, business verification, commission rate, and financial metrics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "applicantUserId": { "type": "string" },
        "nameAr": { "type": "string" },
        "nameEn": { "type": "string" },
        "descriptionAr": { "type": "string" },
        "descriptionEn": { "type": "string" },
        "cityAr": { "type": "string" },
        "cityEn": { "type": "string" },
        "crNumber": { "type": "string" },
        "vatNumber": { "type": "string" },
        "iban": { "type": "string" },
        "ownerName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string", "enum": ["approved", "pending", "suspended", "rejected"] },
        "verifiedBadge": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "commissionRate": { "type": "number" },
        "grossSales": { "type": "number" },
        "platformCommission": { "type": "number" },
        "refundsTotal": { "type": "number" },
        "netEarnings": { "type": "number" },
        "availableBalance": { "type": "number" },
        "nextPayoutDate": { "type": "string" },
        "joinedAt": { "type": "string" },
        "categories": { "type": "array", "items": { "type": "string" } },
        "payoutHistory": { "type": "array", "items": { "type": "object" } },
        "operationalSettings": { "type": "object" }
      },
      "required": ["id", "nameAr", "nameEn", "status", "commissionRate"]
    },
    "PublicSellerProfile": {
      "title": "PublicSellerProfile",
      "description": "Public storefront seller profile containing only marketplace-safe presentation fields",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nameAr": { "type": "string" },
        "nameEn": { "type": "string" },
        "descriptionAr": { "type": "string" },
        "descriptionEn": { "type": "string" },
        "cityAr": { "type": "string" },
        "cityEn": { "type": "string" },
        "status": { "type": "string", "enum": ["approved", "pending", "suspended", "rejected"] },
        "verifiedBadge": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "categories": { "type": "array", "items": { "type": "string" } },
        "joinedAt": { "type": "string" }
      },
      "required": ["id", "nameAr", "nameEn", "status", "verifiedBadge", "rating", "reviewCount", "categories", "joinedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order with line items, VAT calculation, address, payment method, and status timeline",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "sellerIds": { "type": "array", "items": { "type": "string" } },
        "productIds": { "type": "array", "items": { "type": "string" } },
        "items": { "type": "array", "items": { "type": "object" } },
        "subtotal": { "type": "number" },
        "discountAmount": { "type": "number" },
        "shippingFee": { "type": "number" },
        "vatAmount": { "type": "number" },
        "total": { "type": "number" },
        "couponCode": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["placed", "confirmed", "preparing", "shipped", "out_for_delivery", "delivered", "cancelled", "return_requested", "returned"]
        },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "orderNumber", "customerId", "total", "status", "createdAt"]
    },
    "SellerFulfillment": {
      "title": "SellerFulfillment",
      "description": "Seller-isolated fulfillment record for an order shipment, preventing cross-vendor status/tracking tampering in multi-vendor orders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "sellerId": { "type": "string" },
        "customerId": { "type": "string" },
        "sellerItemProductIds": { "type": "array", "items": { "type": "string" } },
        "status": {
          "type": "string",
          "enum": ["confirmed", "preparing", "shipped", "out_for_delivery", "delivered"]
        },
        "trackingNumber": { "type": "string" },
        "carrierAr": { "type": "string" },
        "carrierEn": { "type": "string" },
        "timeline": { "type": "array", "items": { "type": "object" } },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "orderId", "sellerId", "customerId", "sellerItemProductIds", "status", "carrierAr", "carrierEn", "timeline", "createdAt", "updatedAt"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional discount code with percentage or fixed discount, minimum order, and seller scope",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "titleAr": { "type": "string" },
        "titleEn": { "type": "string" },
        "type": { "type": "string", "enum": ["percentage", "fixed"] },
        "value": { "type": "number" },
        "minOrderAmount": { "type": "number" },
        "maxDiscount": { "type": "number" },
        "maxUses": { "type": "number" },
        "usedCount": { "type": "number" },
        "sellerId": { "type": "string" },
        "expiresAt": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "code", "type", "value", "minOrderAmount", "isActive"]
    },
    "Review": {
      "title": "Review",
      "description": "Verified customer product review and star rating",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "title": { "type": "string" },
        "comment": { "type": "string" },
        "verifiedPurchase": { "type": "boolean" },
        "verifiedOrderId": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string", "enum": ["approved", "pending", "hidden"] },
        "sellerReplyAr": { "type": "string" },
        "sellerReplyEn": { "type": "string" },
        "sellerReplyAt": { "type": "string" }
      },
      "required": ["id", "productId", "userName", "rating", "comment", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role (customer, seller, admin), addresses, wallet balance, loyalty points, and wishlist",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "seller", "admin"] },
        "sellerId": { "type": "string" },
        "walletBalance": { "type": "number" },
        "loyaltyPoints": { "type": "number" },
        "referralCode": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Administrative action audit log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "actorName": { "type": "string" },
        "actorRole": { "type": "string" },
        "actionAr": { "type": "string" },
        "actionEn": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "actorName", "actionAr", "createdAt"]
    },
    "ProductQuestion": {
      "title": "ProductQuestion",
      "description": "Customer question and merchant/concierge answer on a product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "questionAr": { "type": "string" },
        "questionEn": { "type": "string" },
        "answerAr": { "type": "string" },
        "answerEn": { "type": "string" },
        "answeredByAr": { "type": "string" },
        "answeredByEn": { "type": "string" },
        "answeredAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "productId", "userId", "userName", "questionAr", "createdAt"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Customer support inquiry ticket",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ticketNumber": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "workflowType": { "type": "string", "enum": ["support", "return_inspection", "payout", "seller_application_info"] },
        "sellerId": { "type": "string" },
        "relatedOrderId": { "type": "string" },
        "orderId": { "type": "string" },
        "orderNumber": { "type": "string" },
        "payoutAmount": { "type": "number" },
        "ibanLast4": { "type": "string" },
        "treasuryStatus": { "type": "string", "enum": ["requested", "under_review", "approved_for_treasury", "rejected", "completed"] },
        "returnRecommendation": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "in_progress", "resolved"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "ticketNumber", "userId", "subject", "message", "status", "createdAt"]
    },
    "HomepageConfig": {
      "title": "HomepageConfig",
      "description": "Public storefront homepage hero, secondary/seasonal banners, flash deal visibility, and free shipping threshold",
      "type": "object",
      "properties": {
        "heroBadgeAr": { "type": "string" },
        "heroBadgeEn": { "type": "string" },
        "heroTitleAr": { "type": "string" },
        "heroTitleEn": { "type": "string" },
        "heroSubtitleAr": { "type": "string" },
        "heroSubtitleEn": { "type": "string" },
        "heroCtaAr": { "type": "string" },
        "heroCtaEn": { "type": "string" },
        "heroSecondaryBannerTitleAr": { "type": "string" },
        "heroSecondaryBannerTitleEn": { "type": "string" },
        "seasonalBannerTitleAr": { "type": "string" },
        "seasonalBannerTitleEn": { "type": "string" },
        "seasonalBannerSubtitleAr": { "type": "string" },
        "seasonalBannerSubtitleEn": { "type": "string" },
        "flashDealsActive": { "type": "boolean" },
        "freeShippingThreshold": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["heroTitleAr", "heroTitleEn", "flashDealsActive", "freeShippingThreshold"]
    },
    "PublicPlatformSettings": {
      "title": "PublicPlatformSettings",
      "description": "Public storefront operational settings, support contacts, shipping fees, minimum payout threshold, and storefront feature flags",
      "type": "object",
      "properties": {
        "marketplaceNameAr": { "type": "string" },
        "marketplaceNameEn": { "type": "string" },
        "supportEmail": { "type": "string" },
        "supportPhone": { "type": "string" },
        "supportWhatsapp": { "type": "string" },
        "supportHoursAr": { "type": "string" },
        "supportHoursEn": { "type": "string" },
        "defaultLanguage": { "type": "string", "enum": ["ar", "en"] },
        "currencyCode": { "type": "string", "enum": ["SAR"] },
        "vatRatePercent": { "type": "number" },
        "vatInclusivePricing": { "type": "boolean" },
        "freeShippingThreshold": { "type": "number" },
        "standardShippingFee": { "type": "number" },
        "expressShippingFee": { "type": "number" },
        "minimumPayoutAmount": { "type": "number" },
        "maintenanceBannerActive": { "type": "boolean" },
        "maintenanceBannerAr": { "type": "string" },
        "maintenanceBannerEn": { "type": "string" },
        "checkoutEnabled": { "type": "boolean" },
        "sellerApplicationsEnabled": { "type": "boolean" },
        "customerReviewsEnabled": { "type": "boolean" },
        "productQuestionsEnabled": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["marketplaceNameAr", "marketplaceNameEn", "supportEmail", "currencyCode", "vatRatePercent", "freeShippingThreshold", "standardShippingFee", "expressShippingFee", "minimumPayoutAmount", "checkoutEnabled"]
    },
    "PrivatePlatformSettings": {
      "title": "PrivatePlatformSettings",
      "description": "Admin-only private governance settings, commission defaults, payout SLA, and internal policies",
      "type": "object",
      "properties": {
        "defaultSellerCommissionRate": { "type": "number" },
        "payoutSlaBusinessDays": { "type": "number" },
        "requireVerifiedBadgeForFeatured": { "type": "boolean" },
        "autoApproveVerifiedSellerProducts": { "type": "boolean" },
        "returnWindowDays": { "type": "number" },
        "allowOriginalPaymentRefunds": { "type": "boolean" },
        "lowStockGlobalDefaultThreshold": { "type": "number" },
        "internalGovernanceNotesAr": { "type": "string" },
        "internalGovernanceNotesEn": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["defaultSellerCommissionRate", "payoutSlaBusinessDays", "returnWindowDays", "updatedAt", "updatedBy"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "All marketplace products"
    },
    "/sellers/{sellerId}": {
      "schema": { "$ref": "#/entities/Seller" },
      "description": "Private marketplace sellers and vendor applications (restricted to Admin, linked seller, and applicant)"
    },
    "/sellerPublicProfiles/{sellerId}": {
      "schema": { "$ref": "#/entities/PublicSellerProfile" },
      "description": "Public storefront seller profiles containing only marketplace-safe fields"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders and order-level financial/return state"
    },
    "/sellerFulfillments/{fulfillmentId}": {
      "schema": { "$ref": "#/entities/SellerFulfillment" },
      "description": "Seller-isolated fulfillment records ({orderId}_{sellerId}) for multi-vendor shipment tracking"
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Promotional coupons and seller campaigns"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Customer product reviews"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles, addresses, and loyalty wallets"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Admin and seller audit trail"
    },
    "/settings/homepageConfig": {
      "schema": { "$ref": "#/entities/HomepageConfig" },
      "description": "Publicly readable storefront homepage configuration; Admin-only write"
    },
    "/settings/publicPlatformSettings": {
      "schema": { "$ref": "#/entities/PublicPlatformSettings" },
      "description": "Publicly readable storefront operational settings and feature flags; Admin-only write"
    },
    "/settings/privatePlatformSettings": {
      "schema": { "$ref": "#/entities/PrivatePlatformSettings" },
      "description": "Admin-only private governance settings; strictly unreadable by non-admin clients"
    },
    "/questions/{questionId}": {
      "schema": { "$ref": "#/entities/ProductQuestion" },
      "description": "Product Q&A items"
    },
    "/tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Customer support tickets"
    }
  }
}
